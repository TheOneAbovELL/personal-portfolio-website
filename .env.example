# Optional. The public URL of the site, without a trailing slash.
# Leave unset on Vercel until a custom domain is attached — the production URL is detected
# automatically. This value is public (it is exposed to the browser); never put secrets here.
NEXT_PUBLIC_SITE_URL=

# --- Ask Omjee (portfolio assistant, POST /api/ask) ---------------------------------------
# All optional. Without a key the assistant still works: common questions are answered
# directly from the site content and everything else falls back to extractive answers.
#
# Server-only secret. Never prefix it with NEXT_PUBLIC_ and never commit a real value.
# When set, questions the built-in rules don't cover are answered by Claude, grounded in
# excerpts retrieved from the portfolio content.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-haiku-4-5 (fast, inexpensive). The call is
# capped at ~350 output tokens and a 12-second timeout, so prefer a model that answers
# quickly without extended thinking.
ASK_MODEL=

# Optional rate-limit overrides (positive integers). Defaults: 8 questions per minute and
# 40 per hour, per client IP, kept in memory per server instance. In local development every
# request shares one address, so raise the hourly value in .env.local if you test heavily.
ASK_RATE_LIMIT_PER_MINUTE=
ASK_RATE_LIMIT_PER_HOUR=
